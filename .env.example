# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com

VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_APP_URL=https://healthflowcloud.com
# Optional legacy key name if you're using the older anon JWT format:
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only HMS integration API.
# Configure these in Vercel/server env, not in browser bundles.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
HMS_API_TOKEN=replace_with_a_long_random_secret
HMS_API_TOKEN_HEADER=x-hms-api-token
HMS_API_ALLOWED_ORIGINS=https://your-hms.example.com

# Optional local branch server mode for serious offline pharmacy operations.
# Use this only on pharmacy laptops that have the local branch server installed.
VITE_BRANCH_SERVER_ENABLED=false
VITE_BRANCH_SERVER_URL=http://localhost:4780
# Do not add a VITE_BRANCH_SERVER_TOKEN value. Browser bundles must not bake in branch tokens.
# The local offline server injects runtime config, and staff LAN machines use the POS Configure button.

# Example:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
