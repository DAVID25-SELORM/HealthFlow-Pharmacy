{
  "name": "healthflow-local-branch-server",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "description": "Local branch server for HealthFlow offline operations and Supabase sync.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "sync": "node src/syncWorker.js",
    "dev": "node --watch src/server.js",
    "rebuild:sqlite": "npm rebuild better-sqlite3 --build-from-source",
    "install:linux-service": "bash scripts/install-linux-service.sh",
    "uninstall:linux-service": "bash scripts/uninstall-linux-service.sh",
    "health:check:linux": "bash scripts/health-check.sh",
    "start:windows": "scripts\\start-branch-server.cmd",
    "sync:windows": "scripts\\start-sync-worker.cmd",
    "install:service": "powershell -ExecutionPolicy Bypass -File scripts\\install-service.ps1",
    "uninstall:service": "powershell -ExecutionPolicy Bypass -File scripts\\uninstall-service.ps1",
    "install:windows-service": "powershell -ExecutionPolicy Bypass -File scripts\\install-windows-service.ps1",
    "uninstall:windows-service": "powershell -ExecutionPolicy Bypass -File scripts\\uninstall-windows-service.ps1",
    "restart:service": "powershell -ExecutionPolicy Bypass -File scripts\\restart-service.ps1",
    "start:local-server": "scripts\\start-local-server.bat",
    "health:check": "powershell -ExecutionPolicy Bypass -File scripts\\health-check.ps1",
    "install:startup": "powershell -ExecutionPolicy Bypass -File scripts\\install-startup-tasks.ps1",
    "uninstall:startup": "powershell -ExecutionPolicy Bypass -File scripts\\uninstall-startup-tasks.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.20.0"
  }
}
