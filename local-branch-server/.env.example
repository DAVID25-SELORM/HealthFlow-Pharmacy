PORT=4780
# Keep loopback for a single-machine installation. For facility-wide access,
# bind to the server's LAN interface (for example 0.0.0.0) and configure TLS.
HOST=127.0.0.1
HEALTHFLOW_TLS_CERT_PATH=
HEALTHFLOW_TLS_KEY_PATH=
BRANCH_SERVER_TOKEN=change-this-long-random-local-token
# Optional comma-separated browser origins allowed to call this server.
# Leave blank to allow only same-origin/no-origin requests plus localhost dev origins.
ALLOWED_ORIGINS=
# Keep false unless you intentionally allow file:// or sandboxed browser pages.
ALLOW_NULL_ORIGIN=false
# Keep false unless other LAN-hosted browser origins must call this server directly.
ALLOW_LAN_ORIGINS=false
# Set only when running behind a trusted reverse proxy. Examples: 1, loopback.
TRUST_PROXY=false
BRANCH_ID=
ORGANIZATION_ID=

# White-label facility branding defaults for local documents, emails, SMS, and reports.
# These do not rename HealthFlow internals; they only control visible facility branding.
FACILITY_NAME=
FACILITY_TYPE=
FACILITY_LOGO_URL=
FACILITY_ADDRESS=
FACILITY_PHONE=
FACILITY_EMAIL=
FACILITY_WEBSITE=
FACILITY_RECEIPT_FOOTER=
FACILITY_REPORT_FOOTER=
FACILITY_THEME_PRIMARY_COLOR=#16a085
FACILITY_THEME_SECONDARY_COLOR=#0f766e
FACILITY_THEME_ACCENT_COLOR=#f59e0b
# ✅ SQLITE CORRUPTION FIX START
HEALTHFLOW_DB_PATH=C:\HealthFlowLocal\data\healthflow-branch.sqlite
# Legacy fallback if HEALTHFLOW_DB_PATH is blank.
SQLITE_PATH=./data/healthflow-branch.sqlite
# ✅ SQLITE CORRUPTION FIX END
SYNC_INTERVAL_SECONDS=30
INVENTORY_PULL_INTERVAL_SECONDS=300
# Maximum duration of a server-verified staff session during an internet outage (8-720 hours).
OFFLINE_SESSION_HOURS=720
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=600
OFFLINE_LOGIN_RATE_LIMIT_WINDOW_MS=300000
OFFLINE_LOGIN_RATE_LIMIT_MAX_REQUESTS=10
BRANCH_SYNC_TOKEN=change-this-to-the-token-registered-in-supabase

# Supabase is used only by the local server sync worker.
# Do not put any Supabase sync key in the React frontend.
SUPABASE_URL=https://your-project.supabase.co
# Prefer an anon/publishable key plus BRANCH_SYNC_TOKEN for these dedicated sync RPCs.
# A service role key also works but should be avoided on ordinary cashier laptops.
SUPABASE_SYNC_KEY=your-supabase-anon-or-publishable-key

# Signed local server updates. The manifest URL may point to Vercel, object
# storage, or a release server. Keep the public key identical at every branch.
HEALTHFLOW_UPDATE_MANIFEST_URL=https://health-flow-pharmacy.vercel.app/branch-updates/manifest.json
HEALTHFLOW_UPDATE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAfYvTqK9SXyxhoKHFNuwOJwpzaoc4LXSeTMW2bSWAhiY=\n-----END PUBLIC KEY-----
HEALTHFLOW_UPDATE_CHANNEL=stable
HEALTHFLOW_WINDOWS_SERVICE_NAME=HealthFlowOfflineServer
HEALTHFLOW_UPDATE_CHECK_TIMEOUT_MS=15000
HEALTHFLOW_UPDATE_MAX_PACKAGE_BYTES=524288000
# Set 0 to disable scheduled checks. Automatic installation is opt-in.
HEALTHFLOW_UPDATE_AUTO_CHECK_HOURS=24
HEALTHFLOW_UPDATE_AUTO_INSTALL=false

# Use the same permanent value as the Supabase Edge Function
# NHIA_CONFIG_SECRET_KEY when pulling encrypted NHIA credentials into this
# branch server. Generate it once for production and do not rotate it during
# facility onboarding unless you have confirmed old credentials still decrypt.
NHIA_CONFIG_SECRET_KEY=

# Payment providers are used only by the local branch server/backend.
# Never put these secrets in the React frontend or browser localStorage.
PAYMENT_DEFAULT_PROVIDER=paystack
PAYMENT_CURRENCY=GHS
# Public HTTPS base URL that Hubtel/Paystack can call for webhooks, e.g. https://pay.example.com
PAYMENT_PUBLIC_BASE_URL=
# Optional browser return URL after hosted checkout.
PAYMENT_RETURN_URL=

PAYSTACK_ENABLED=false
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_DEFAULT_EMAIL=

HUBTEL_ENABLED=false
HUBTEL_BASE_URL=https://devp-sms03726-api.hubtel.com/v1
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_REQUEST_MONEY_PATH=/request-money/{mobileNumber}
# Optional HMAC secret if your Hubtel webhook setup sends a signature header.
HUBTEL_WEBHOOK_SECRET=

# Communication providers are used only by the local branch server/backend.
# Keep SMTP and SMS secrets out of React, localStorage, and public Supabase tables.
COMMUNICATION_EMAIL_ENABLED=false
COMMUNICATION_SMS_ENABLED=false
COMMUNICATION_DEFAULT_EMAIL_PROVIDER=smtp
COMMUNICATION_DEFAULT_SMS_PROVIDER=arkesel

# SMTP email setup for birthday greetings, refill reminders, NHIS renewal notices, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@CHANGE_ME_FACILITY_DOMAIN
SMTP_FROM_NAME=

# SMS setup. Use the generic SMS_* keys for any provider.
# For Arkesel/Akessel-style setups, either SMS_* or SMS_AKESEL_* aliases work.
SMS_PROVIDER=arkesel
SMS_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TIMEOUT_MS=30000
SMS_AKESEL_BASE_URL=
SMS_AKESEL_API_KEY=
SMS_AKESEL_SENDER_ID=
SMS_AKESSEL_BASE_URL=
SMS_AKESSEL_API_KEY=
SMS_AKESSEL_SENDER_ID=
SMS_HUBTEL_BASE_URL=
SMS_HUBTEL_CLIENT_ID=
SMS_HUBTEL_CLIENT_SECRET=
SMS_HUBTEL_SENDER_ID=

# Public CLAIM-it/NHIA middleware mode.
# Point https://claimbridge.healthflowgh.com/json-api at this server.
CLAIM_BRIDGE_ENABLED=false
CLAIM_BRIDGE_PUBLIC_PATH=/json-api
CLAIMIT_UPSTREAM_BASE_URL=https://elig.nhia.gov.gh:5000
# CCC/CC generation follows the NHIA checkcccode.php flow:
# POST /api/hmis/genCCC with JSON { CardNo, CardType } and NHIA headers.
CLAIMIT_UPSTREAM_CREDENTIAL_MODE=api_key
# Keep false for normal facility installs. Set true only for a dedicated
# single-facility bridge whose .env intentionally owns the official credentials.
CLAIMIT_ALLOW_ENV_CREDENTIAL_OVERRIDES=false
CLAIMIT_UPSTREAM_MEMBER_LOOKUP_PATH=/api/hmis/genCCC
CLAIMIT_UPSTREAM_CC_ENDPOINT_PATH=/api/hmis/genCCC
# Dedicated NHIA eligibility/genCCC host.
NHIA_ELIGIBILITY_BASE_URL=https://elig.nhia.gov.gh:5000
# Facility-specific identity used in CLAIM-it payloads.
NHIA_FACILITY_CODE=
NHIA_PROVIDER_ID=
NHIA_CREDENTIAL_CODE=
NHIA_CLAIMS_OFFICER_NAME=
NHIA_ACCREDITATION_EXPIRY_DATE=
# Local CLAIM-it installation that receives processed claims.
CLAIMIT_SUBMIT_BASE_URL=http://localhost:31719/json-api
CLAIMIT_CLAIM_SUBMIT_PATH=/claims
# Optional official NHIA eligibility/genCCC credentials. Keep these on the branch/bridge server only.
NHIA_API_KEY=
NHIA_API_KEY_HEADER=x-nhia-apikey
NHIA_API_SECRET=
NHIA_API_SECRET_HEADER=x-nhia-apisecret
# Backwards-compatible aliases used by older bridge deployments.
CLAIMIT_UPSTREAM_API_KEY=
CLAIMIT_UPSTREAM_API_KEY_HEADER=x-nhia-apikey
CLAIMIT_UPSTREAM_API_SECRET=
CLAIMIT_UPSTREAM_API_SECRET_HEADER=x-nhia-apisecret
CLAIMIT_UPSTREAM_BEARER_TOKEN=
CLAIMIT_UPSTREAM_USERNAME=
CLAIMIT_UPSTREAM_PASSWORD=
CLAIM_BRIDGE_TOKEN=change-this-long-random-production-bridge-token
CLAIM_BRIDGE_TOKEN_HEADER=x-claim-bridge-token
CLAIM_BRIDGE_TIMEOUT_MS=30000
CLAIM_BRIDGE_BODY_LIMIT=10mb
